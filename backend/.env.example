# Aggarwal Steels API Configuration
APP_NAME="Aggarwal Steels API"
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Server Settings
HOST=0.0.0.0
PORT=8000

# CORS Origins (Comma-separated for multiple origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001

# Database Configuration (Default: SQLite file)
DATABASE_URL=sqlite:///./aggarwal_steels.db
# For PostgreSQL: postgresql://username:password@localhost:5432/aggarwal_steels

# Notification & Contact Desk
SALES_EMAIL=info@aggarwalsteels.com
SALES_PHONE=+918800885185
