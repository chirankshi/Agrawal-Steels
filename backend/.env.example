# Aggarwal Steels API Configuration
APP_NAME="Aggarwal Steels API"
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Server Settings
HOST=0.0.0.0
PORT=8000

# CORS Origins (comma-separated, no trailing slash). The production domains
# aggarwalsteel.com / www.aggarwalsteel.com / agrawal-steels.vercel.app are
# always allowed; list extra ones here.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://127.0.0.1:3002,http://127.0.0.1:3003

# Database Configuration (Default: SQLite file)
DATABASE_URL=sqlite:///./aggarwal_steels.db
# Supabase (direct connection; URL-encode special characters in the password, e.g. @ -> %40):
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
# The backend falls back to the SQLite file above if the remote database is unreachable.

# Notification & Contact Desk
SALES_EMAIL=sales@aggarwalsteel.com
SALES_PHONE=+917300070778

# Admin panel login (same values go into Render -> Environment for live)
ADMIN_EMAIL=admin@aggarwalsteel.com
ADMIN_PASSWORD=change-me
# Random string that signs admin session tokens (python -c "import secrets; print(secrets.token_urlsafe(32))")
ADMIN_SECRET=change-me-too

# Admin image uploads go to Supabase Storage through this server.
# SUPABASE_SERVICE_KEY is the project's SECRET key (Supabase dashboard ->
# Project Settings -> API Keys -> "secret" / service_role). Never put it in the
# frontend. Without it, production refuses uploads from the server and the
# admin falls back to a direct, insert-only upload.
SUPABASE_URL=https://rjtuuzehypemfvdaiusi.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=product-images

# Optional, not used: email alerts (SMTP_HOST, SMTP_USER, SMTP_PASSWORD, NOTIFY_EMAILS).
# New enquiries are announced inside the admin panel instead.
